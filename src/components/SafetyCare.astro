---
const points = [
  {
    t: "Experienced, gentle groomers",
    d: "Over 20 years of hands-on grooming in Huntington Beach. We read every dog's body language and go at their pace — never forced, never rushed.",
    icon: `<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"/>`,
  },
  {
    t: "Clean tools, safe products",
    d: "Blades, brushes and tables are sanitized between every dog. We use gentle, dog-safe shampoos and take extra care around eyes, ears and skin.",
    icon: `<path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4"/>`,
    fill: false,
  },
  {
    t: "A wellness look-over, every visit",
    d: "While we groom, we keep an eye out for lumps, hot spots, ear issues or overgrown nails — and we'll gently flag anything worth a vet's look.",
    icon: `<path d="M12 21s-7-4.4-9.3-8.5C1 9.5 2.4 6 5.8 6 8 6 9.3 7.5 12 10c2.7-2.5 4-4 6.2-4 3.4 0 4.8 3.5 3.1 6.5C19 16.6 12 21 12 21Z"/>`,
    fill: true,
  },
];
---
<section id="safety" class="relative py-20 md:py-28 overflow-hidden grain">
  <div class="blob blob-sky floaty-slow" style="width:22rem;height:22rem;top:-4rem;left:-8rem;opacity:.22"></div>

  <div class="wrap relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- content side -->
      <div class="order-2 lg:order-1">
        <div class="reveal">
          <span class="eyebrow">Safety &amp; care</span>
          <h2 class="mt-3 text-4xl md:text-5xl text-ink">Handled with<br class="hidden md:block"/> patience &amp; care</h2>
          <p class="mt-4 text-inksoft text-lg">Your dog's comfort and safety come before everything else. Here's how we keep every visit calm, clean and healthy.</p>
        </div>

        <div class="mt-8 space-y-4">
          {points.map((p, i) => (
            <div class="card p-5 flex items-start gap-4 reveal" data-delay={i * 80}>
              <span class="grid place-items-center w-11 h-11 rounded-xl bg-surface2 text-skydeep shrink-0" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill={p.fill ? "currentColor" : "none"} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
              </span>
              <div>
                <h3 class="text-lg text-ink">{p.t}</h3>
                <p class="mt-1 text-sm text-inksoft leading-relaxed">{p.d}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Vaccination policy callout -->
        <div class="mt-4 rounded-2xl border border-sky/40 bg-surface2 p-5 reveal" data-delay="120">
          <div class="flex items-start gap-3">
            <span class="grid place-items-center w-10 h-10 rounded-xl bg-sunny text-[#24363F] shrink-0" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3Z"/><path d="M9 12l2 2 4-4"/></svg>
            </span>
            <div>
              <h3 class="text-base text-ink font-semibold">Vaccination policy</h3>
              <p class="mt-1 text-sm text-inksoft leading-relaxed">For the safety of every pup in the shop, we ask that dogs be current on their core vaccinations (including rabies). Please bring records for your dog's first visit — call us if you have any questions.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- image side with overlay + text-shadow -->
      <div class="order-1 lg:order-2 relative reveal">
        <div class="blob blob-coral floaty" style="width:15rem;height:15rem;bottom:-3rem;right:-3rem;opacity:.28"></div>
        <div class="relative z-10 overflow-hidden blobby shadow-2xl" style="border:6px solid var(--surface)">
          <img src="/images/hug.jpg" alt="A groomer gently hugging a calm, happy dog" loading="lazy" width="900" height="700" class="w-full h-[380px] md:h-[500px] object-cover" />
          <!-- gradient overlay ensures AA contrast for the caption text -->
          <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(12,28,40,0) 45%, rgba(12,28,40,.72) 100%)" aria-hidden="true"></div>
          <div class="absolute bottom-0 inset-x-0 p-6">
            <p class="text-white font-[var(--font-display)] font-semibold text-xl leading-tight" style="text-shadow:0 2px 14px rgba(0,0,0,.6)">Calm hands, happy tails.</p>
            <p class="text-white/90 text-sm mt-1" style="text-shadow:0 1px 10px rgba(0,0,0,.6)">Comfort first — from the first sniff to pickup.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
