---
import { site } from "../data/site";
---
<section id="top" class="relative overflow-hidden grain">
  <!-- Background video (first-paint safe: poster shows instantly) -->
  <div class="absolute inset-0 z-0">
    <video
      class="w-full h-full object-cover"
      autoplay muted loop playsinline preload="metadata"
      poster="/images/hero-poster.jpg"
      aria-hidden="true"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
    </video>
    <!-- Overlay for AA-contrast text -->
    <div class="absolute inset-0" style="background:
      linear-gradient(180deg, rgba(12,28,40,.62) 0%, rgba(12,28,40,.42) 40%, rgba(12,28,40,.66) 100%),
      radial-gradient(120% 90% at 15% 20%, rgba(20,104,159,.45), transparent 60%);"></div>
  </div>

  <!-- floating decor -->
  <div class="blob blob-sunny floaty" style="width:16rem;height:16rem;top:-4rem;right:-3rem;opacity:.4;z-index:1"></div>

  <div class="wrap relative z-10 pt-20 pb-24 md:pt-28 md:pb-32">
    <div class="max-w-2xl hero-in">
      <span class="hi inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur px-3.5 py-1.5 text-white text-sm font-semibold border border-white/30" style="--i:0">
        <span class="wag" aria-hidden="true">🐾</span> Huntington Beach · Since 2003
      </span>

      <h1 class="hi mt-5 text-white font-semibold text-[2.6rem] leading-[1.02] sm:text-6xl md:text-[4.2rem]" style="--i:1; text-shadow:0 2px 18px rgba(0,0,0,.45)">
        Happy dogs,<br/>
        <span class="text-sunny">fresh &amp; fluffy.</span>
      </h1>

      <p class="hi mt-5 text-white/95 text-lg md:text-xl max-w-xl" style="--i:2; text-shadow:0 1px 10px rgba(0,0,0,.5)">
        Gentle, experienced grooming for every breed — baths, full grooms, breed cuts and nail trims from a Huntington Beach salon that's been pampering local pups for over 20 years.
      </p>

      <div class="hi mt-8 flex flex-wrap gap-3" style="--i:3">
        <a href="#book" class="btn btn-primary btn-shine">Book your pup 🐶</a>
        <a href={site.phoneHref} class="btn btn-frost">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          {site.phone}
        </a>
      </div>

      <ul class="hi mt-9 flex flex-wrap gap-x-6 gap-y-2 text-white/90 text-sm font-semibold" style="--i:4">
        <li class="flex items-center gap-2"><span class="text-sunny" aria-hidden="true">✔</span> Gentle with nervous pups</li>
        <li class="flex items-center gap-2"><span class="text-sunny" aria-hidden="true">✔</span> All breeds &amp; sizes</li>
        <li class="flex items-center gap-2"><span class="text-sunny" aria-hidden="true">✔</span> Family-run &amp; local</li>
      </ul>
    </div>
  </div>

  <!-- soft wave into next section -->
  <div class="absolute bottom-0 inset-x-0 z-10 leading-none" aria-hidden="true">
    <svg viewBox="0 0 1440 90" preserveAspectRatio="none" class="w-full h-[54px] md:h-[80px]" style="display:block">
      <path d="M0,64 C240,10 480,10 720,40 C960,70 1200,90 1440,44 L1440,90 L0,90 Z" fill="var(--bg)"></path>
    </svg>
  </div>
</section>

<style>
  /* Resting state is ALWAYS visible — first paint can never read blank,
     even while the enhancement animation is still delayed. */
  .hero-in .hi { opacity: 1; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-in .hi {
      /* transform-only rise: opacity stays 1 the entire time, so no frame
         (including the delayed first frame with fill:both) is ever invisible */
      animation: heroUp .8s cubic-bezier(0.16,1,0.3,1) both;
      animation-delay: calc(var(--i) * 110ms);
    }
    @keyframes heroUp { from { transform: translateY(22px); } to { transform: none; } }
  }
</style>
