---
const steps = [
  { n: "01", t: "Book & tell us about your pup", d: "Call or send a request with your dog's breed, size and any quirks — anxious, senior, sensitive skin. We plan the perfect time slot.", emoji: "📅" },
  { n: "02", t: "A calm, gentle welcome", d: "Your dog arrives to a friendly hello and a stress-free space. We move at their pace and keep things happy from the very first sniff.", emoji: "🐕" },
  { n: "03", t: "Bath, brush & the works", d: "Warm bath, blow-dry, brush-out, ears, nails and a hand-finished cut styled just how you like it. Clean, comfy and cared for.", emoji: "🛁" },
  { n: "04", t: "Pick up one happy dog", d: "You get back a soft, fresh, great-smelling pup with a bandana and a wagging tail — and a standing invite to come back soon.", emoji: "🎀" },
];
---
<section id="how" class="relative py-20 md:py-28 grain overflow-hidden">
  <div class="blob blob-sunny floaty" style="width:20rem;height:20rem;top:2rem;right:-7rem;opacity:.22"></div>
  <div class="wrap relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-4 lg:sticky lg:top-28 reveal">
        <span class="eyebrow">What to expect</span>
        <h2 class="mt-3 text-4xl md:text-5xl text-ink">A grooming day<br class="hidden md:block"/> made easy</h2>
        <p class="mt-4 text-inksoft text-lg">No mystery, no stress — just four simple steps from booking to a happy hand-off.</p>
        <a href="#book" class="mt-7 btn btn-primary btn-shine">Start with a booking</a>
      </div>

      <ol class="lg:col-span-8 relative">
        <span class="hidden sm:block absolute left-[27px] top-4 bottom-4 w-0.5 bg-line" aria-hidden="true"></span>
        {steps.map((s, i) => (
          <li class="relative flex gap-5 pb-8 last:pb-0 reveal" data-delay={i * 90}>
            <span class="relative z-10 grid place-items-center w-14 h-14 rounded-2xl bg-surface border border-line text-2xl shrink-0 shadow-sm" aria-hidden="true">{s.emoji}</span>
            <div class="card flex-1 p-6">
              <div class="flex items-center gap-3">
                <span class="font-[var(--font-display)] font-semibold text-coraldeep text-sm tracking-widest">{s.n}</span>
                <h3 class="text-xl text-ink">{s.t}</h3>
              </div>
              <p class="mt-2 text-inksoft leading-relaxed">{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
