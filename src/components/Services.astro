---
import { services } from "../data/site";

const icons: Record<string, string> = {
  bath: `<path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3Z"/><path d="M6 12V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2"/><path d="M10 6h.01"/><path d="M6 19l-1 2M18 19l1 2"/>`,
  scissors: `<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.12 15.88M14.47 14.48 20 20M8.12 8.12 12 12"/>`,
  star: `<path d="M12 3l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9 6.8 19l1-5.8L3.5 9.2l5.9-.9L12 3Z"/>`,
  paw: `<path d="M9 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm6 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM5.5 15.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm13 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM12 13c-2.2 0-4 1.9-4 3.8 0 1.4 1 2.2 2.4 2.2.7 0 1.1-.3 1.6-.3s.9.3 1.6.3c1.4 0 2.4-.8 2.4-2.2C16 14.9 14.2 13 12 13Z"/>`,
  brush: `<path d="M4 20c2-2 3-4 3-6M9.5 14.5 18 6a2.1 2.1 0 0 0-3-3l-8.5 8.5M7 12l5 5"/>`,
  heart: `<path d="M12 21s-7-4.4-9.3-8.5C1 9.5 2.4 6 5.8 6 8 6 9.3 7.5 12 10c2.7-2.5 4-4 6.2-4 3.4 0 4.8 3.5 3.1 6.5C19 16.6 12 21 12 21Z"/>`,
};
---
<section id="services" class="relative py-20 md:py-28 grain overflow-hidden">
  <div class="blob blob-sky floaty-slow" style="width:22rem;height:22rem;top:6rem;left:-8rem;opacity:.28"></div>
  <div class="blob blob-coral floaty" style="width:18rem;height:18rem;bottom:-4rem;right:-6rem;opacity:.22"></div>

  <div class="wrap relative z-10">
    <div class="max-w-2xl reveal">
      <span class="eyebrow">Grooming menu</span>
      <h2 class="mt-3 text-4xl md:text-5xl text-ink">Everything your pup needs<br class="hidden md:block"/> to look &amp; feel great</h2>
      <p class="mt-4 text-inksoft text-lg">From a quick nail trim to a full breed-standard cut, every service is done gently, by hand, at a pace your dog is comfortable with.</p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s, i) => (
        <article
          class={`svc group relative flex flex-col p-6 md:p-7 reveal ${s.featured ? "svc-feat" : "card"}`}
          data-delay={i * 70}
        >
          {s.featured && <span class="absolute -top-3 left-6 chip !bg-coraldeep !text-white !border-transparent">★ Most popular</span>}
          <div class="flex items-center justify-between gap-3">
            <span class={`grid place-items-center w-14 h-14 rounded-2xl shrink-0 transition-transform duration-500 group-hover:-rotate-6 group-hover:scale-110 ${s.featured ? "bg-white/20 text-white" : "bg-surface2 text-skydeep"}`} aria-hidden="true">
              <svg width="26" height="26" viewBox="0 0 24 24" fill={s.icon === "star" || s.icon === "paw" || s.icon === "heart" ? "currentColor" : "none"} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
            </span>
            <span class={`font-[var(--font-display)] font-semibold text-lg ${s.featured ? "text-white" : "text-coraldeep"}`}>{s.price}</span>
          </div>

          <h3 class={`mt-5 text-2xl ${s.featured ? "text-white" : "text-ink"}`}>{s.name}</h3>
          <p class={`mt-1 text-sm font-semibold ${s.featured ? "text-white/80" : "text-skydeep"}`}>{s.tag}</p>
          <p class={`mt-3 text-[0.97rem] leading-relaxed ${s.featured ? "text-white/90" : "text-inksoft"}`}>{s.blurb}</p>

          <ul class={`mt-5 space-y-2 text-sm ${s.featured ? "text-white/90" : "text-ink"}`}>
            {s.includes.map((inc) => (
              <li class="flex items-start gap-2">
                <svg class={s.featured ? "text-sunny mt-0.5 shrink-0" : "text-coral mt-0.5 shrink-0"} width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                {inc}
              </li>
            ))}
          </ul>

          <a href="#book" class={`mt-6 btn btn-shine ${s.featured ? "btn-primary" : "btn-outline"} w-full`}>Book this</a>
        </article>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-inksoft reveal">
      <span class="font-semibold text-ink">Prices are representative starting points.</span>
      Final pricing depends on your dog's size, coat condition &amp; the style you choose — <a href="#book" class="link-underline">call for a friendly quote</a>.
    </p>
  </div>
</section>

<style>
  .svc { transition: transform .5s cubic-bezier(0.16,1,0.3,1), box-shadow .5s cubic-bezier(0.16,1,0.3,1); }
  .svc:hover { transform: translateY(-8px); }
  .card.svc:hover { box-shadow: 0 34px 60px -34px var(--shadow-sky); }
  .svc-feat {
    color: #fff; border-radius: 1.75rem; border: 1px solid transparent;
    background:
      radial-gradient(120% 120% at 20% 0%, #ff9a6f 0%, transparent 55%),
      linear-gradient(160deg, #2b93cf 0%, #14689f 100%);
    box-shadow: 0 30px 60px -28px var(--shadow-sky);
  }
</style>
