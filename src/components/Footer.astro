---
import { site, hours } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-ink text-white/85">
  <div class="wrap py-16 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2 max-w-sm">
      <div class="flex items-center gap-2.5">
        <span class="grid place-items-center w-10 h-10 rounded-2xl bg-sunny text-[#24363F]" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M4.5 12.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm5-4a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm5 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm5 4a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM12 12c-2.7 0-5 2.4-5 4.8 0 1.7 1.3 2.7 3 2.7.9 0 1.5-.4 2-.4s1.1.4 2 .4c1.7 0 3-1 3-2.7 0-2.4-2.3-4.8-5-4.8Z"/></svg>
        </span>
        <span class="font-[var(--font-display)] font-semibold text-xl text-white">Happy Dog Grooming Salon</span>
      </div>
      <p class="mt-4 text-white/70 leading-relaxed">Gentle, experienced dog grooming for the whole Huntington Beach community — proudly pampering local pups since 2003.</p>
      <a href={site.facebook} target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-5 text-white/85 hover:text-sunny transition-colors font-semibold">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12Z"/></svg>
        Follow on Facebook
      </a>
    </div>

    <div>
      <h3 class="font-[var(--font-display)] font-semibold text-white">Visit</h3>
      <address class="mt-3 not-italic text-white/70 leading-relaxed">
        {site.addressLine}<br/>
        {site.city}, {site.state} {site.zip}<br/>
        <a href={site.phoneHref} class="hover:text-sunny transition-colors">{site.phone}</a>
      </address>
    </div>

    <div>
      <h3 class="font-[var(--font-display)] font-semibold text-white">Hours</h3>
      <dl class="mt-3 space-y-1.5 text-sm text-white/70">
        {hours.map((h) => (
          <div><dt class="inline font-semibold text-white/85">{h.d}:</dt> <dd class="inline">{h.h}</dd></div>
        ))}
      </dl>
      <a href="#book" class="btn btn-primary btn-shine mt-5 !py-2.5 !px-5 !text-[0.95rem]">Book grooming</a>
    </div>
  </div>

  <div class="border-t border-white/12">
    <div class="wrap py-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-white/55">
      <p>© {year} Happy Dog Grooming Salon · Huntington Beach, CA</p>
      <p class="text-center">
        Design preview by <a href="https://saeditech.com" target="_blank" rel="noopener" class="text-white/80 hover:text-sunny font-semibold">Saedi Tech</a>
      </p>
    </div>
    <div class="wrap pb-6">
      <p class="text-[11px] leading-relaxed text-white/40">
        This is an unaffiliated concept website created to demonstrate a design for Happy Dog Grooming Salon. It is not the salon's official site. Business name, address, phone and hours are shown from public listings; pricing, testimonials and imagery are representative samples for illustration only. Please call the salon to confirm current services and pricing.
      </p>
    </div>
  </div>
</footer>
