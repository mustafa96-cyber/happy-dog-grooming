---
import { faqs } from "../data/site";
---
<section id="faq" class="relative py-20 md:py-28 overflow-hidden bg-surface2/60">
  <div class="wrap relative z-10 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-4 reveal">
      <span class="eyebrow">Good to know</span>
      <h2 class="mt-3 text-4xl md:text-5xl text-ink">Questions,<br/>answered</h2>
      <p class="mt-4 text-inksoft text-lg">Still curious about something? Give us a call — we love talking dogs.</p>
      <a href="#book" class="mt-6 btn btn-primary btn-shine">Book grooming</a>
    </div>

    <div class="lg:col-span-8 space-y-3">
      {faqs.map((f, i) => (
        <details class="faq card px-6 py-1 reveal" data-delay={i * 60}>
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-5 font-[var(--font-display)] font-semibold text-lg text-ink">
            {f.q}
            <span class="faq-ico grid place-items-center w-8 h-8 rounded-full bg-surface2 text-skydeep shrink-0 transition-transform duration-300" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <p class="pb-5 -mt-1 text-inksoft leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq[open] .faq-ico { transform: rotate(45deg); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq[open] { box-shadow: 0 26px 50px -32px var(--shadow-sky); }
</style>
