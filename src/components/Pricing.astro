---
import { sizeTiers, pricing } from "../data/site";
---
<section id="pricing" class="relative py-20 md:py-28 overflow-hidden bg-surface2/60 grain">
  <div class="blob blob-sunny floaty-slow" style="width:20rem;height:20rem;top:4rem;right:-7rem;opacity:.2"></div>

  <div class="wrap relative z-10">
    <div class="max-w-2xl reveal">
      <span class="eyebrow">Transparent pricing</span>
      <h2 class="mt-3 text-4xl md:text-5xl text-ink">Grooming prices,<br class="hidden md:block"/> by your dog's size</h2>
      <p class="mt-4 text-inksoft text-lg">No surprises at pickup. Here's roughly what each service runs by size — final pricing depends on coat condition, matting and the style you choose.</p>
    </div>

    <!-- Size legend -->
    <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 reveal">
      {sizeTiers.map((t) => (
        <div class="card p-4">
          <div class="font-[var(--font-display)] font-semibold text-ink">{t.name}</div>
          <div class="text-xs text-skydeep font-semibold mt-0.5">{t.weight}</div>
          <p class="text-xs text-inksoft mt-1.5 leading-snug">{t.ex}</p>
        </div>
      ))}
    </div>

    <!-- Desktop table (md+) -->
    <div class="mt-8 card overflow-hidden reveal hidden md:block">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-surface2">
            <th scope="col" class="p-5 font-[var(--font-display)] font-semibold text-ink text-lg">Service</th>
            {sizeTiers.map((t) => (
              <th scope="col" class="p-5 font-[var(--font-display)] font-semibold text-ink text-center">{t.name}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {pricing.map((row) => (
            <tr class={`border-t border-line ${row.featured ? "bg-sunny/10" : ""}`}>
              <th scope="row" class="p-5 align-top">
                <span class="flex items-center gap-2 font-[var(--font-display)] font-semibold text-ink text-lg">
                  {row.service}
                  {row.featured && <span class="chip !bg-coraldeep !text-white !border-transparent !py-0.5 !text-[0.68rem]">Most popular</span>}
                </span>
                <span class="block text-sm text-inksoft mt-1 font-normal">{row.note}</span>
              </th>
              {row.prices.map((p) => (
                <td class="p-5 text-center font-[var(--font-display)] font-semibold text-coraldeep text-lg whitespace-nowrap">{p}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Mobile stacked cards (< md) — avoids any horizontal overflow -->
    <div class="mt-8 grid gap-4 md:hidden">
      {pricing.map((row, i) => (
        <div class={`p-5 reveal ${row.featured ? "svc-feat" : "card"}`} data-delay={i * 60}>
          <div class="flex items-center gap-2">
            <h3 class={`font-[var(--font-display)] font-semibold text-xl ${row.featured ? "text-white" : "text-ink"}`}>{row.service}</h3>
            {row.featured && <span class="chip !bg-white/20 !text-white !border-transparent !py-0.5 !text-[0.66rem]">Popular</span>}
          </div>
          <p class={`text-sm mt-1 ${row.featured ? "text-white/85" : "text-inksoft"}`}>{row.note}</p>
          <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2.5">
            {sizeTiers.map((t, j) => (
              <div class={`flex items-center justify-between gap-2 border-b pb-2 ${row.featured ? "border-white/20" : "border-line"}`}>
                <dt class={`text-sm ${row.featured ? "text-white/80" : "text-inksoft"}`}>{t.name}</dt>
                <dd class={`font-[var(--font-display)] font-semibold ${row.featured ? "text-sunny" : "text-coraldeep"}`}>{row.prices[j]}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>

    <p class="mt-6 text-sm text-inksoft reveal">
      <span class="font-semibold text-ink">Prices are representative starting points</span> and vary by size, coat &amp; condition.
      <a href="#book" class="link-underline">Call for a friendly, exact quote →</a>
    </p>
  </div>
</section>

<style>
  .svc-feat {
    color: #fff; border-radius: 1.75rem; border: 1px solid transparent;
    background:
      radial-gradient(120% 120% at 20% 0%, #ff9a6f 0%, transparent 55%),
      linear-gradient(160deg, #2b93cf 0%, #14689f 100%);
    box-shadow: 0 30px 60px -28px var(--shadow-sky);
  }
</style>
