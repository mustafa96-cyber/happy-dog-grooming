---
const rowA = [
  { src: "samoyed", alt: "Fluffy white Samoyed sitting among confetti after a groom" },
  { src: "golden", alt: "Smiling golden retriever sitting in the grass" },
  { src: "frenchie", alt: "French bulldog in a cozy yellow hoodie" },
  { src: "corgi", alt: "Corgi surrounded by little red paper hearts" },
  { src: "pug", alt: "Black pug wrapped in a soft knit scarf" },
  { src: "collie", alt: "Happy brown-and-white collie at the beach" },
];
const rowB = [
  { src: "running", alt: "Little white dog running joyfully across the lawn" },
  { src: "wash", alt: "Golden retriever getting a gentle bath" },
  { src: "lab", alt: "Chocolate lab licking its nose, being silly" },
  { src: "play", alt: "Border collie trotting with a colorful ball" },
  { src: "pom", alt: "Fluffy little dog dressed up, freshly groomed" },
  { src: "golden-pup", alt: "Golden retriever puppy relaxing in the grass" },
  { src: "toller", alt: "Toller retriever gently holding a plush toy" },
];
const tilt = ["-2deg", "1.5deg", "-1deg", "2deg", "-1.5deg", "1deg", "-2deg"];
---
<section id="gallery" class="relative py-20 md:py-28 overflow-hidden bg-surface2/60">
  <div class="wrap relative z-10">
    <div class="max-w-2xl reveal">
      <span class="eyebrow">The happy wall</span>
      <h2 class="mt-3 text-4xl md:text-5xl text-ink">Wagging tails &amp; fresh fluff</h2>
      <p class="mt-4 text-inksoft text-lg">A little parade of the pups who make our days. Hover to pause and say hi. 👋</p>
    </div>
  </div>

  <!-- Row A -->
  <div class="relative mt-12 select-none" aria-label="Photos of happy groomed dogs">
    <div class="marquee-track gap-5 px-2.5">
      {[...rowA, ...rowA].map((p, i) => (
        <figure class="gitem shrink-0 w-[260px] md:w-[300px]" style={`--r:${tilt[i % tilt.length]}`}>
          <img src={`/images/${p.src}.jpg`} alt={i < rowA.length ? p.alt : ""} aria-hidden={i >= rowA.length ? "true" : undefined} loading="lazy" width="300" height="360" class="w-full h-[300px] md:h-[340px] object-cover blobby" />
        </figure>
      ))}
    </div>
  </div>

  <!-- Row B (reverse) -->
  <div class="relative mt-5 select-none">
    <div class="marquee-track marquee-rev gap-5 px-2.5">
      {[...rowB, ...rowB].map((p, i) => (
        <figure class="gitem shrink-0 w-[260px] md:w-[300px]" style={`--r:${tilt[(i + 3) % tilt.length]}`}>
          <img src={`/images/${p.src}.jpg`} alt={i < rowB.length ? p.alt : ""} aria-hidden={i >= rowB.length ? "true" : undefined} loading="lazy" width="300" height="360" class="w-full h-[240px] md:h-[280px] object-cover blobby-2" />
        </figure>
      ))}
    </div>
  </div>

  <div class="wrap relative z-10 mt-12 text-center reveal">
    <a href="#book" class="btn btn-coral btn-shine">Bring your pup in ✂️</a>
  </div>
</section>

<style>
  .gitem { transform: rotate(var(--r)); transition: transform .45s cubic-bezier(0.16,1,0.3,1); }
  .gitem img { box-shadow: 0 22px 44px -26px var(--shadow-soft); border: 4px solid var(--surface); }
  .gitem:hover { transform: rotate(0deg) scale(1.05); z-index: 5; }
</style>
