---
const items = [
  { k: "years", label: "Years grooming Huntington Beach dogs", count: 20, suffix: "+", icon: "cake" },
  { k: "since", label: "A local salon, family-run since 2003", value: "2003", icon: "home" },
  { k: "breeds", label: "All breeds & sizes — from toy to fluffy giant", value: "All", icon: "paw" },
];
---
<section class="relative -mt-2 z-20">
  <div class="wrap">
    <div class="card grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-line overflow-hidden">
      {items.map((it, i) => (
        <div class="flex items-center gap-4 p-6 reveal" data-delay={i * 90}>
          <span class="grid place-items-center w-12 h-12 rounded-2xl bg-surface2 text-skydeep shrink-0" aria-hidden="true">
            {it.icon === "cake" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8M4 16s1-1 3-1 3 2 5 2 3-2 5-2 3 1 3 1M12 4v3M8 6v1M16 6v1"/></svg>}
            {it.icon === "home" && <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5M5 9.5V21h14V9.5"/></svg>}
            {it.icon === "paw" && <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M4.5 12.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm5-4a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm5 0a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm5 4a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM12 12c-2.7 0-5 2.4-5 4.8 0 1.7 1.3 2.7 3 2.7.9 0 1.5-.4 2-.4s1.1.4 2 .4c1.7 0 3-1 3-2.7 0-2.4-2.3-4.8-5-4.8Z"/></svg>}
          </span>
          <div>
            <div class="font-[var(--font-display)] font-semibold text-2xl text-ink leading-none">
              {it.count ? <span data-count={it.count} data-suffix={it.suffix}>0{it.suffix}</span> : it.value}
            </div>
            <p class="text-sm text-inksoft mt-1.5 leading-snug">{it.label}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
