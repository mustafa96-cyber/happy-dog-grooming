---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TrustStrip from "../components/TrustStrip.astro";
import Services from "../components/Services.astro";
import Pricing from "../components/Pricing.astro";
import AddOns from "../components/AddOns.astro";
import Gallery from "../components/Gallery.astro";
import HowItWorks from "../components/HowItWorks.astro";
import WhyUs from "../components/WhyUs.astro";
import SafetyCare from "../components/SafetyCare.astro";
import Reviews from "../components/Reviews.astro";
import FAQ from "../components/FAQ.astro";
import Book from "../components/Book.astro";
import Location from "../components/Location.astro";
import Footer from "../components/Footer.astro";
---
<Layout>
  <Header />
  <main>
    <Hero />
    <TrustStrip />
    <Services />
    <Pricing />
    <AddOns />
    <Gallery />
    <HowItWorks />
    <WhyUs />
    <SafetyCare />
    <Reviews />
    <FAQ />
    <Book />
    <Location />
  </main>
  <Footer />
  <!-- spacer so the sticky mobile bar never covers content -->
  <div class="h-20 md:hidden" aria-hidden="true"></div>
</Layout>
